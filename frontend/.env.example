# Để trống khi chạy Vite proxy local tới http://localhost:8080.
# Khi deploy FE riêng, đặt URL gốc của Backend, ví dụ https://api.example.com
VITE_API_URL=
# PRODUCTION (Vercel):
# Dat trong Vercel > Project Settings > Environment Variables.
# Chi dien origin cua Backend, KHONG them /api vi code da tu them /api/... vao path.
# VITE_API_URL=https://your-backend.onrender.com

# Chỉ dùng cho Vite dev server. Chỉnh cổng theo Backend nếu cổng 8080 đang bận.
VITE_API_PROXY_TARGET=http://localhost:8080
