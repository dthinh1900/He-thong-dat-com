# Bien moi truong danh cho BACKEND (Spring Boot).
# File mau de tham khao; Spring Boot khong tu dong doc file .env nay.
# Local: dùng application-local.properties.example hoặc khai báo trong PowerShell/IDE.
# Render: khai báo trong Environment, không upload file .env.
DB_URL=jdbc:postgresql://localhost:5432/meal_booking_db
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480
FRONTEND_ORIGIN=http://localhost:5173
EXCLUDE_WEEKENDS=true

